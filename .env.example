# Optional: GitHub username to dynamically fetch public repositories on the /projects page.
# If unset, the site falls back to the static project data in src/data/projects.ts
NEXT_PUBLIC_GITHUB_USERNAME=

# Optional: contact form endpoint (Formspree, Resend function, etc.)
# If unset, the contact form falls back to a mailto: link.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Sanity project and public published-content dataset
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-14

# Shared secret for the Sanity webhook that revalidates blog routes (server only)
SANITY_REVALIDATE_SECRET=

# One-time migration only; never expose this privileged token in NEXT_PUBLIC_ variables
SANITY_API_TOKEN=
